#!/usr/bin/env bash
# pre-commit: .env の BLOCKED_TERMS を staged 内容/ファイル名で検出したら commit を block する。
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
env_file="$repo_root/.env"

[ -f "$env_file" ] || exit 0  # .env なければ何もしない

terms="$(grep -E '^BLOCKED_TERMS=' "$env_file" | head -1 | sed -E 's/^BLOCKED_TERMS=//; s/^"//; s/"$//')"
[ -n "$terms" ] || exit 0

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged_files" ] || exit 0

failed=0
IFS=',' read -ra TERMS <<< "$terms"
for term_raw in "${TERMS[@]}"; do
  term="$(printf '%s' "$term_raw" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [ -z "$term" ] && continue

  # ファイル名 (case-insensitive)
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if printf '%s' "$f" | grep -Fqi "$term"; then
      printf '✗ blocked term "%s" in staged filename: %s\n' "$term" "$f" >&2
      failed=1
    fi
  done <<< "$staged_files"

  # 内容 (staged diff の追加行 / 変更行)
  matches="$(git diff --cached -U0 2>/dev/null | command grep '^+' | command grep -Fni "$term" || true)"
  if [ -n "$matches" ]; then
    printf '✗ blocked term "%s" in staged content:\n' "$term" >&2
    printf '%s\n' "$matches" | head -10 >&2
    failed=1
  fi
done

if [ "$failed" -eq 1 ]; then
  printf '\nCommit blocked by .githooks/pre-commit. Edit .env (BLOCKED_TERMS) to manage.\n' >&2
  exit 1
fi
exit 0
