#!/usr/bin/env bash
# pre-push: harness 配布の整合性チェック
# - extras submodule の未 commit / 未 push → ブロック
# - 未管理スキル / SSOT ドリフト → 警告（ブロックしない。未管理スキルの block は harness-doctor.sh）
set -euo pipefail

# git は hook 実行時に GIT_DIR 等を export する。unset しないと後続の unittest 内の
# git subprocess（git init --bare / git config 等）が temp repo ではなく実 repo に
# 作用し .git/config を破壊する（2026-07-12 に core.bare=true 汚染が実際に発生）。
# cwd は repo root なので unset 後も git は正しく discovery できる。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

repo_root="$(git rev-parse --show-toplevel)"
submodule="$repo_root/packages/extras/_active"
claude_dir="${CLAUDE_DIR:-$HOME/.claude}"

# distribute.py は tomllib を使うため Python 3.11+ が必要。macOS では
# `mise exec -- python3` が system Python に解決される環境があるため、mise が
# 解決した実体を直接使う。バージョンはここに書かず mise.toml に委ねる
# （cwd = repo root なので mise が repo の pin を解決する）。以前は python@3.12
# をハードコードしており、mise.toml が 3.14 へ上がった際に置き去りになって
# 依存（PyYAML）が片方の interpreter にしか入らない事故が起きた（2026-08-05）。
if command -v mise >/dev/null 2>&1; then
  if ! PYTHON_BIN="$(mise which python3 2>/dev/null)" || \
     [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
    printf '  🚫 mise が実行可能なPythonを解決できません\n' >&2
    exit 1
  fi
  PYTHON=("$PYTHON_BIN")
else
  PYTHON=(python3)
fi

# ==============================
# ブロック: extras submodule
# ==============================

if [ -d "$submodule/.git" ] || [ -f "$submodule/.git" ]; then

  # 1. サブモジュール内に未 commit の変更がないか
  if git -C "$submodule" status --porcelain | head -1 | read -r _; then
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    printf '  🚫 extras/_active に未 commit の変更があります\n' >&2
    printf '  → cd packages/extras/_active && git add . && git commit\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
    exit 1
  fi

  # 2. サブモジュールのローカル commit がリモートに push されているか
  local_head="$(git -C "$submodule" rev-parse HEAD 2>/dev/null)"
  remote_head="$(git -C "$submodule" rev-parse origin/main 2>/dev/null || echo "")"

  if [ -n "$remote_head" ] && [ "$local_head" != "$remote_head" ]; then
    unpushed="$(git -C "$submodule" log --oneline origin/main..HEAD 2>/dev/null)"
    if [ -n "$unpushed" ]; then
      printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
      printf '  🚫 extras/_active に未 push の commit があります\n' >&2
      printf '%s\n' "$unpushed" | while read -r line; do
        printf '    %s\n' "$line" >&2
      done
      printf '  → cd packages/extras/_active && git push origin main\n' >&2
      printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
      exit 1
    fi
  fi

  # 3. 親リポジトリが指すサブモジュール ref が最新か
  parent_ref="$(git ls-tree HEAD packages/extras/_active 2>/dev/null | cut -f1 | perl -lane 'print $F[2]')"
  if [ -n "$parent_ref" ] && [ "$parent_ref" != "$local_head" ]; then
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    printf '  🚫 extras/_active のサブモジュール参照が古いです\n' >&2
    printf '  → git add packages/extras/_active && git commit\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
    exit 1
  fi
fi

# ==============================
# 警告: 未管理スキル（ブロックしない）
# ==============================
# 判定は scripts/harness_lib/unmanaged_skills.py（harness-doctor.sh と共有）。
# 以前はここで push を block していたが、~/.claude/skills や ~/.agents/skills の状態は
# push する PR の内容と無関係なローカル環境の話で、無関係な commit の push を止めて
# 再承認ループを生んでいた（2026-08-29）。環境診断は harness-doctor.sh の責務に移し、
# ここは気づきのための警告表示だけを担う。

agents_skills_dir="${AGENTS_SKILLS_DIR:-$HOME/.agents/skills}"
unmanaged_cli="$repo_root/scripts/harness_lib/unmanaged_skills.py"

if [ -f "$unmanaged_cli" ] && [ -d "$repo_root/packages/core/skills" ] && \
   command -v "${PYTHON[0]}" >/dev/null 2>&1; then
  set +e
  unmanaged_output="$("${PYTHON[@]}" "$unmanaged_cli" \
    --repo-root "$repo_root" --claude-dir "$claude_dir" --agents-skills-dir "$agents_skills_dir" 2>/dev/null)"
  set -e
  extras_state="$(printf '%s\n' "$unmanaged_output" | head -1)"
  unmanaged="$(printf '%s\n' "$unmanaged_output" | tail -n +2 | sed '/^$/d')"
  count="$(printf '%s\n' "$unmanaged" | sed '/^$/d' | wc -l | tr -d ' ')"

  if [ "$count" -gt 0 ]; then
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    if [ "$extras_state" = "extras=known" ]; then
      printf '  ⚠️  未管理スキル %s 件（core / extras / rulesync.lock / allowlist のどこにも宣言が無い。push は止めない）\n' "$count" >&2
    else
      printf '  ⚠️  未管理の可能性があるスキル %s 件（extras submodule 未初期化のため extras 由来か判定できず）\n' "$count" >&2
    fi
    printf '%s\n' "$unmanaged" | head -10 | while read -r s; do
      printf '    - %s\n' "$s" >&2
    done
    [ "$count" -gt 10 ] && printf '    ... 他 %s 件\n' "$((count - 10))" >&2
    printf '  → ./scripts/harness-doctor.sh で詳細確認。整理方法: rulesync.jsonc に source 追記 / packages/core/skills へ追加 / unmanaged-skills-allowlist.json に宣言 / 削除\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
  fi
fi

# ==============================
# 警告: distribute 全カテゴリのドリフト検出（ブロックしない）
# 対象は claude ターゲットのみ（毎日使う主要ターゲットで、ライブ直編集事故も
# claude で起きるため。codex/opencode は /sync-settings --check で随時確認）
# ==============================

# $claude_dir が存在しない環境（CI 等）はスキップ
# scripts/distribute.py が無い repo（fixture 等）や python3 不在の場合もスキップ
if [ -d "$claude_dir" ] && \
   [ -f "$repo_root/scripts/distribute.py" ] && \
   command -v "${PYTHON[0]}" >/dev/null 2>&1; then

  # --check の契約: exit 0 = drift なし / exit 1 = drift あり（warn-only なので block はしない）
  if drift_output="$("${PYTHON[@]}" "$repo_root/scripts/distribute.py" claude --check --live "$claude_dir" 2>&1)"; then
    : # drift なし
  else
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    printf '  ⚠️  distribute ドリフトを検出（harness ≠ local）\n' >&2
    echo "$drift_output" | while IFS= read -r line; do
      printf '    %s\n' "$line" >&2
    done
    printf '  ライブ側の修正が意図的なら bootstrap で巻き戻る前に harness へ還流せよ\n' >&2
    printf '  → ./scripts/bootstrap.sh で再配布（harness 側の更新が原因の場合）\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
  fi

fi

# ==============================
# ブロック: ローカル検証ゲート（CI に載る前にここで止める）
# ==============================
# 2026-07-11 にローカル全 green・CI 3 連続 failure が実際に発生した。当時は main 直 push
# 運用で CI が「壊れた後の検出器」でしかなかったのが直接の理由だが、PR 運用に移った今も
# 赤い CI を PR に載せてから直す往復は残るため、unittest + validator を push 前に強制する
# （実測 ~15 秒）。緊急時は HARNESS_SKIP_TESTS=1 git push で回避可。

if [ "${HARNESS_SKIP_TESTS:-}" != "1" ] && command -v "${PYTHON[0]}" >/dev/null 2>&1 && \
   [ -d "$repo_root/scripts/tests" ]; then

  if ! "${PYTHON[@]}" "$repo_root/scripts/run-tests.py" >/dev/null 2>&1; then
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    printf '  🚫 unittest が失敗しています。push を中止しました\n' >&2
    printf '  → mise exec -- python scripts/run-tests.py で確認\n' >&2
    printf '  （緊急回避: HARNESS_SKIP_TESTS=1 git push）\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
    exit 1
  fi

  if ! "${PYTHON[@]}" "$repo_root/scripts/validate-harness.py" >/dev/null 2>&1; then
    printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n' >&2
    printf '  🚫 validate-harness がエラーを検出。push を中止しました\n' >&2
    printf '  → mise exec -- python scripts/validate-harness.py で確認\n' >&2
    printf '  （緊急回避: HARNESS_SKIP_TESTS=1 git push）\n' >&2
    printf '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n' >&2
    exit 1
  fi
fi

exit 0
