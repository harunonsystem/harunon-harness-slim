{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dimensions", "claims"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" }
    },
    "claims": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/targetClaims" }
    }
  },
  "$defs": {
    "targetClaims": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/claim" }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "statement": { "type": "string", "pattern": ".+" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contains"],
      "properties": {
        "path": { "type": "string", "pattern": ".+" },
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": ".+" }
        }
      }
    }
  }
}
