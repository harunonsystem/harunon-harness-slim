{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness model-routing table",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "models", "defaults", "routes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^\\S+$" }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "build"],
      "properties": {
        "design": { "$ref": "#/$defs/assignment" },
        "build": { "$ref": "#/$defs/assignment" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "string",
      "enum": ["claude", "opencode", "omp", "pi", "codex"]
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh", "max"]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string" },
        "effort": { "$ref": "#/$defs/effort" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "role", "purpose", "model", "effort", "projections"],
      "properties": {
        "runtime": { "$ref": "#/$defs/runtime" },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "purpose": {
          "type": "string",
          "enum": ["design", "build"]
        },
        "model": { "type": "string" },
        "effort": { "$ref": "#/$defs/effort" },
        "reason": { "type": "string", "pattern": "\\S" },
        "projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection" }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "modelKey", "effortKeys"],
      "properties": {
        "path": { "type": "string", "pattern": "^packages/targets/" },
        "format": {
          "type": "string",
          "enum": ["toml", "json", "frontmatter", "omp-roles"]
        },
        "provider": { "type": "string", "pattern": "^\\S+$" },
        "providerKey": { "type": "string", "pattern": "^\\S+$" },
        "modelKey": { "type": "string", "pattern": "^\\S+$" },
        "effortKeys": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\S+$" }
        }
      }
    }
  }
}
