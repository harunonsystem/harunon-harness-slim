{
  // 外部 skill の上流追跡が目的。targets/features を明示し、暗黙デフォルト
  // (agentsmd + rules) によるルート AGENTS.md 再生成を構造的に排除する。
  // 生成物は使わないため generate は CI・週次 workflow のどこでも実行しない。
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "features": [
    "skills"
  ],
  "sources": [
    {
      "source": "cloudflare/skills",
      "skills": [
        "agents-sdk",
        "cloudflare",
        "cloudflare-email-service",
        "cloudflare-one",
        "cloudflare-one-migrations",
        "durable-objects",
        "sandbox-migrate-to-next",
        "sandbox-next",
        "sandbox-stable",
        "turnstile-spin",
        "web-perf",
        "workers-best-practices",
        "wrangler"
      ]
    },
    {
      "source": "mattpocock/skills",
      "skills": [
        "codebase-design",
        "diagnosing-bugs",
        "domain-modeling",
        "improve-codebase-architecture",
        "prototype",
        "research",
        "resolving-merge-conflicts",
        "setup-matt-pocock-skills",
        "tdd",
        "to-spec",
        "to-tickets",
        "triage",
        "wayfinder"
      ],
      "path": "skills/engineering"
    },
    // difit / improve / grill-with-docs は harness 側の版を正本として残すため追跡しない
    // （ADR-011 の例外 3 件。upstream に無い節・LICENSE.md・runtime 中立表現を持つ）
    {
      "source": "jackwener/opencli",
      "skills": [
        "opencli-usage",
        "opencli-browser",
        "opencli-adapter-author"
      ]
    },
    {
      "source": "cursor/plugins",
      "skills": [
        "unslop"
      ],
      "path": "pstack/skills"
    },
    // `npx skills add` で ~/.agents/skills に直接入っていたものを rulesync 管理に載せ替えた
    // （2026-08-26 棚卸し）。同時に見つかった agmsg は install.sh / server / db を持つアプリで、
    // rulesync は skill ディレクトリ直下しか取れず scripts/ が欠けるため対象外
    // （packages/core/unmanaged-skills-allowlist.json で明示的に許可）。
    // sentry-fix-issues（getsentry/sentry-for-ai、upstream では skills-legacy/ に退役）も追跡しない。
    // Sentry の調査・修正は harness 自作の sentry-fix と sentry-mcp plugin が担う。
    // archify（tt-a1i/archify）は零依存の .mjs レンダラ群。ADR-011 に従い upstream を正本にする。
    {
      "source": "tt-a1i/archify",
      "skills": [
        "archify"
      ],
      "path": "."
    },
    {
      "source": "vercel-labs/skills",
      "skills": [
        "find-skills"
      ],
      "path": "skills"
    },
    // Ponytail本家のskills/を逐語追跡する。runtime固有のextension/pluginは各CLIの公式導入手順で扱う。
    {
      "source": "DietrichGebert/ponytail",
      "skills": [
        "ponytail",
        "ponytail-audit",
        "ponytail-debt",
        "ponytail-gain",
        "ponytail-help",
        "ponytail-review"
      ],
      "path": "skills"
    }
  ]
}
