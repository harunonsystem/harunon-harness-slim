{
  "_comment": "build-public-slim.py が packages/targets/codex/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "codex",
  "displayName": "Codex Desktop",
  "configDir": "~/.codex",
  "configDirEnv": "CODEX_HOME",
  "managedPaths": [
    "AGENTS.md",
    "agents",
    "config.toml",
    "harunon/claude-hooks/approve-push.sh",
    "harunon/claude-hooks/block-dangerous-in-bash.sh",
    "harunon/claude-hooks/block-edit-on-main.sh",
    "harunon/claude-hooks/block-grep-in-bash.sh",
    "harunon/claude-hooks/block-japanese-tech-writing.sh",
    "harunon/claude-hooks/block-secrets-in-commit.sh",
    "harunon/claude-hooks/fix_gfm_tables.py",
    "harunon/claude-hooks/harness-publication-gate.sh",
    "harunon/claude-hooks/lib",
    "harunon/claude-hooks/post-edit-checks.sh",
    "harunon/claude-hooks/require-evidence-for-completion.py",
    "harunon/claude-hooks/rtk-rewrite.sh",
    "harunon/claude-hooks/verify-before-commit.sh",
    "harunon/codex-hooks",
    "harunon/hook-runner",
    "harunon/policy",
    "harunon/rules/pr-body.md",
    "harunon/workflows",
    "references/writing/explain-before-shorten",
    "references/writing/unslop",
    "rules",
    "skills"
  ],
  "settingsFile": "config.toml",
  "settingsFormat": "toml",
  "settingsKeys": [
    "approval_policy",
    "default_permissions",
    "permissions.harunon.extends",
    "mcp_servers.linear-server"
  ],
  "settingsRemoveKeys": [
    "model_catalog_json",
    "network_access",
    "sandbox_mode",
    "sandbox_workspace_write",
    "agents.max_threads",
    "mcp_servers.jev",
    "mcp_servers.sentry",
    "mcp_servers.figma",
    "mcp_servers.notion"
  ],
  "ledger": ".harunon-slim.installed.json"
}
