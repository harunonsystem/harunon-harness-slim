{
  "_comment": "build-public-slim.py が packages/targets/codex/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "codex",
  "displayName": "Codex Desktop",
  "configDir": "~/.codex",
  "configDirEnv": "CODEX_HOME",
  "managedPaths": [
    "AGENTS.md",
    "agents",
    "config.toml",
    "rules",
    "skills"
  ],
  "settingsFile": "config.toml",
  "settingsFormat": "toml",
  "settingsKeys": [
    "approval_policy",
    "default_permissions",
    "permissions.harunon.extends",
    "mcp_servers.sentry",
    "mcp_servers.linear-server",
    "mcp_servers.figma",
    "mcp_servers.notion"
  ],
  "settingsRemoveKeys": [
    "model_catalog_json",
    "network_access",
    "sandbox_mode",
    "sandbox_workspace_write",
    "agents.max_threads",
    "mcp_servers.jev"
  ],
  "ledger": ".harunon-slim.installed.json"
}
