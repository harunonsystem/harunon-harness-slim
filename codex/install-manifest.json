{
  "_comment": "build-public-slim.py が packages/targets/codex/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "codex",
  "displayName": "Codex Desktop",
  "configDir": "~/.codex",
  "configDirEnv": "CODEX_HOME",
  "managedPaths": [
    "AGENTS.md",
    "agents",
    "commands.md",
    "config.toml",
    "keybindings.json",
    "review-high.config.toml",
    "review.config.toml",
    "rules",
    "skills"
  ],
  "settingsFile": "config.toml",
  "settingsFormat": "toml",
  "settingsKeys": [
    "model",
    "model_provider",
    "model_reasoning_effort",
    "plan_mode_reasoning_effort",
    "model_reasoning_summary",
    "model_verbosity",
    "model_context_window",
    "model_auto_compact_token_limit",
    "review_model",
    "approval_policy",
    "approvals_reviewer",
    "default_permissions",
    "personality",
    "sandbox_mode",
    "sandbox_workspace_write.network_access",
    "suppress_unstable_features_warning",
    "agents.max_threads",
    "agents.max_depth",
    "agents.default_subagent_model",
    "agents.default_subagent_reasoning_effort",
    "memories.disable_on_external_context",
    "memories.generate_memories",
    "memories.use_memories",
    "tui.status_line",
    "notice.fast_default_opt_out",
    "desktop.avatar-overlay-pet-visible",
    "desktop.computerUseAlwaysHidePictureInPicture"
  ],
  "ledger": ".harunon-slim.installed.json"
}
