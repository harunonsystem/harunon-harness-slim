{
  "_comment": "build-public-slim.py が packages/targets/claude/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "claude",
  "displayName": "Claude Code",
  "configDir": "~/.claude",
  "configDirEnv": null,
  "managedPaths": [
    "CLAUDE.md",
    "agents",
    "commands",
    "commands.md",
    "hooks",
    "policy",
    "rules",
    "settings.json",
    "skills",
    "workflows"
  ],
  "settingsFile": "settings.json",
  "settingsFormat": "json",
  "settingsKeys": [
    "hooks",
    "sandbox",
    "permissions.deny",
    "permissions.ask",
    "autoMode.hard_deny",
    "autoMode.soft_deny",
    "fallbackModel",
    "switchModelsOnFlag",
    "env.HARNESS_RUNTIME",
    "env.NODE_USE_ENV_PROXY",
    "env.DISABLE_AUTOUPDATER"
  ],
  "settingsRemoveKeys": [
    "enabledPlugins.mattpocock-skills@mattpocock",
    "extraKnownMarketplaces.mattpocock",
    "env.ENABLE_TOOL_SEARCH",
    "env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS",
    "env.CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING",
    "env.CLAUDE_CODE_SUBAGENT_MODEL",
    "env.CLAUDE_CODE_DISABLE_AUTO_MEMORY",
    "env.CLAUDE_CODE_THRIFTY_SONIC",
    "env.ENABLE_STOP_REVIEW"
  ],
  "ledger": ".harunon-slim.installed.json"
}
