{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-plan-model.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/run-bang-command.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-prompt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-pattern-reminders.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-worktree-remove.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-japanese-tech-writing.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/harness-publication-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-repeated-codex-review.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-commit-without-difit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-grep-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-cd-prefix-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-secrets-in-commit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-before-commit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-before-push.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-edit-on-main.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-webfetch-github.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lesson-warnings.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-compaction.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-japanese-output.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-evidence-for-completion.py"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-permission-denied.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-edit-checks.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-restart-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-improvement-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-review-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/set-codex-review-flag.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/set-difit-flag.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-desc-sync-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scan-new-skills.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker *",
      "gh *",
      "gcloud *",
      "terraform *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git commit *",
      "git -C * commit *",
      "git branch *",
      "git -C * branch *",
      "./scripts/bootstrap.sh",
      "./scripts/bootstrap.sh *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "nodejs.org",
        "docs.anthropic.com",
        "json.schemastore.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude",
        "~/.codex",
        "~/.config/opencode",
        "~/.agents",
        "~/.omp/agent",
        "~/.pi/agent",
        "~/.local/bin",
        "~/ghq/github.com/harunonsystem/harunon-harness",
        "~/.local/state/cclens",
        "~/.local/state/cclens-multi",
        "~/Library/pnpm/store",
        "~/Library/Caches/pnpm",
        "~/..claude.harness-distribution.lock",
        "~/..codex.harness-distribution.lock",
        "~/..agents.harness-distribution.lock",
        "~/.config/.opencode.harness-distribution.lock",
        "~/.local/.bin.harness-distribution.lock",
        "~/.pi/.agent.harness-distribution.lock",
        "~/.omp/.agent.harness-distribution.lock"
      ],
      "denyWrite": [
        "~/.claude/policy",
        "~/.claude/rigor-patterns.json",
        "~/.claude/rigor.local.json"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(claude worktree:*)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/policy/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/rigor-patterns.json)",
      "Edit(~/.claude/rigor.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/RTK.md)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/workflows/**)",
      "Edit(~/.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(rtk git push:*)",
      "Bash(rtk gh pr create:*)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "git commit / git push で --no-verify（短縮形 -n を含む）を使って hook をスキップしてはならない。hook が失敗したら原因を直して再実行する",
      "main / master への直接 push、および force push（--force / -f / +ref）は禁止",
      "main / master ブランチの削除は禁止",
      "GitHub リポジトリの削除・設定変更（gh repo delete / gh repo edit）は禁止",
      "netlify の deploy / build / api コマンドは、ユーザーが明示的にその実行を指示した場合のみ。preview の再ビルド目的で netlify api を叩かない（本番ビルドが走る）"
    ],
    "soft_deny": [
      "$defaults",
      "git push はユーザーが明示的に許可した場合のみ実行する。commit と push を 1 コマンドに連結しない",
      "メインリポジトリのチェックアウト上で branch を作成しない。worktree を作成してから作業する",
      "main / master のメイン checkout（worktree ではない方）で git commit しない。worktree を作成してから作業する",
      "git update-ref はユーザーの明示的な許可がある場合のみ",
      "git clean -f / -fd はユーザーの明示的な許可がある場合のみ",
      "PR の merge / close はユーザーの明示的な許可がある場合のみ",
      "新規 GitHub リポジトリの作成は、既存の同種 repo を検索して報告し、ユーザーが許可した場合のみ",
      "GitHub release の削除はユーザーの明示的な許可がある場合のみ",
      "git remote の追加・変更・削除はユーザーの明示的な許可がある場合のみ",
      "pi / omp を npm や pnpm でグローバル install / update しない。mise の exact pin（mise run agents:update）で更新する",
      "PR / issue へのコメント投稿（gh pr comment / gh api での comment 書き込み）はユーザーの明示的な許可がある場合のみ",
      "rtk init -g / --global は rtk のグローバル設定ファイルを上書きするため実行しない。harness 配布版は再配布で復元する",
      "git stash drop / clear はユーザーの明示的な許可がある場合のみ",
      "harness の SSOT 配下への rm はユーザーの明示的な許可がある場合のみ",
      "メインの共有 checkout（linked worktree ではない方）で git stash / git reset --hard / git checkout -- / git restore を実行しない。他セッションの未 commit 変更を巻き込む"
    ]
  },
  "env": {
    "HARNESS_RUNTIME": "claude"
  }
}
