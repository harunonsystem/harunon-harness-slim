{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "fallbackModel": [],
  "switchModelsOnFlag": false,
  "env": {
    "HARNESS_RUNTIME": "claude",
    "NODE_USE_ENV_PROXY": "1",
    "DISABLE_AUTOUPDATER": "0",
    "HARNESS_EXPECTED_PLAN": "",
    "HARNESS_EXPECTED_ORG": ""
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker *",
      "gh *",
      "gcloud *",
      "terraform *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git commit *",
      "git -C * commit *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "nodejs.org",
        "docs.anthropic.com",
        "json.schemastore.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude",
        "~/.codex",
        "~/.config/opencode",
        "~/.agents",
        "~/.omp/agent",
        "~/.pi/agent",
        "~/.local/bin",
        "~/Library/pnpm/store",
        "~/Library/Caches/pnpm",
        "~/..claude.harness-distribution.lock",
        "~/..codex.harness-distribution.lock",
        "~/..agents.harness-distribution.lock",
        "~/.config/.opencode.harness-distribution.lock",
        "~/.local/.bin.harness-distribution.lock",
        "~/.pi/.agent.harness-distribution.lock",
        "~/.omp/.agent.harness-distribution.lock"
      ],
      "denyWrite": [
        "~/.claude/policy",
        "~/.claude/rigor-patterns.json",
        "~/.claude/rigor.local.json"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
