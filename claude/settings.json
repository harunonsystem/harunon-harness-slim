  "autoMode": {
    "hard_deny": [
      "$defaults",
      "git commit / git push で --no-verify（短縮形 -n を含む）を使って hook をスキップしてはならない。hook が失敗したら原因を直して再実行する",
      "main / master への直接 push、および force push（--force / -f / +ref）は禁止",
      "main / master ブランチの削除は禁止",
      "GitHub リポジトリの削除・設定変更（gh repo delete / gh repo edit）は禁止",
      "netlify の deploy / build / api コマンドは、ユーザーが明示的にその実行を指示した場合のみ。preview の再ビルド目的で netlify api を叩かない（本番ビルドが走る）"
    ],
    "soft_deny": [
      "$defaults",
      "git push はユーザーが明示的に許可した場合のみ実行する。commit と push を 1 コマンドに連結しない",
      "メインリポジトリのチェックアウト上で branch を作成しない。gwm で worktree を切ってから作業する",
      "main / master のメイン checkout（worktree ではない方）で git commit しない。gwm で worktree を切ってから作業する",
      "git update-ref はユーザーの明示的な許可がある場合のみ",
      "git clean -f / -fd はユーザーの明示的な許可がある場合のみ",
      "PR の merge / close はユーザーの明示的な許可がある場合のみ",
      "新規 GitHub リポジトリの作成は、既存の同種 repo を検索して報告し、ユーザーが許可した場合のみ",
      "GitHub release の削除はユーザーの明示的な許可がある場合のみ",
      "git remote の追加・変更・削除はユーザーの明示的な許可がある場合のみ",
      "pi / omp を npm や pnpm でグローバル install / update しない。mise の exact pin（mise run agents:update）で更新する",
      "PR / issue へのコメント投稿（gh pr comment / gh api での comment 書き込み）はユーザーの明示的な許可がある場合のみ",
      "rtk init -g / --global は rtk のグローバル設定ファイルを上書きするため実行しない。harness 配布版は再配布で復元する",
      "git stash drop / clear はユーザーの明示的な許可がある場合のみ",
      "harness の SSOT 配下への rm はユーザーの明示的な許可がある場合のみ",
      "メインの共有 checkout（linked worktree ではない方）で git stash / git reset --hard / git checkout -- / git restore を実行しない。他セッションの未 commit 変更を巻き込む"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-plan-model.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/run-bang-command.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-prompt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-pattern-reminders.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-worktree-create.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-japanese-tech-writing.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-without-codex-review.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-repeated-codex-review.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-commit-without-difit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-grep-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-cd-prefix-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-in-bash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-secrets-in-commit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-before-commit.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-before-push.sh"
          }
        ]
      },
      {
        "matcher": "Bash|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-gwm-for-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-edit-on-main.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-webfetch-github.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lesson-warnings.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-compaction.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-japanese-output.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-evidence-for-completion.py"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-permission-denied.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" =~ \\.(json|jsonc)$ ]] && tmp=$(mktemp) && jq --tab '.' \"$FILE_PATH\" > \"$tmp\" && mv \"$tmp\" \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" =~ \\.md$ ]] && python3 ~/.claude/hooks/fix_gfm_tables.py \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "[[ \"$FILE_PATH\" =~ \\.sh$ ]] && command -v shellcheck >/dev/null && shellcheck -S warning \"$FILE_PATH\" || true"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-restart-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-improvement-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-review-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/set-codex-review-flag.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/set-difit-flag.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-desc-sync-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scan-new-skills.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y @owloops/claude-powerline@latest --style=powerline --theme=tokyonight"
  },
