{
	"defaultProvider": "openai-codex",
	"defaultModel": "gpt-6-sol",
	"defaultThinkingLevel": "medium",
	"theme": "dark",
	"quietStartup": true,
	"collapseChangelog": true,
	"hideThinkingBlock": true,
	"steeringMode": "all",
	"followUpMode": "all",
	"treeFilterMode": "no-tools",
	"compaction": {
		"enabled": true,
		"reserveTokens": 172000,
		"keepRecentTokens": 20000
	},
	"enableAnalytics": false,
	"enableInstallTelemetry": false,
	"enableSkillCommands": true,
	"packages": [
		"npm:@howaboua/pi-codex-conversion@3.0.34",
		"npm:@howaboua/pi-codex-web-run@0.0.2",
		"npm:@howaboua/pi-codex-imagegen@0.0.5",
		"git:github.com/NVlabs/SoL-Pi@bd005888b9b8a3fcdb511feb91fc27d3dfa8f2b1",
		"npm:pi-web-access@0.29.0",
		"npm:pi-mcp-adapter@2.34.0",
		"npm:@ff-labs/pi-fff@0.10.6",
		"npm:@pi-lab/input-history@1.0.3",
		"npm:pi-powerline-footer@0.17.1",
		"npm:pi-interactive-shell@0.15.2",
		"npm:@tian.zuo/pi-devin-acp@0.4.0"
	],
	"enabledModels": [
		"opencode-zen/*",
		"openai-codex/*",
		"devin/*"
	],
	"observational-memory": {
		"compactAfterTokens": 81000,
		"compactAfterTokensMode": "ratio",
		"compactAfterTokensRatio": 0.5,
		"model": {
			"provider": "openai-codex",
			"id": "gpt-6-luna",
			"thinking": "low"
		}
	},
	"powerline": {
		"welcome": false
	}
}
