{
  "_comment": "build-public-slim.py が packages/targets/pi/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "pi",
  "displayName": "pi coding agent",
  "configDir": "~/.pi/agent",
  "configDirEnv": null,
  "managedPaths": [
    "AGENTS.md",
    "agents",
    "claude-hooks/approve-pr.sh",
    "claude-hooks/approve-push.sh",
    "claude-hooks/block-dangerous-in-bash.sh",
    "claude-hooks/block-edit-on-main.sh",
    "claude-hooks/block-grep-in-bash.sh",
    "claude-hooks/block-secrets-in-commit.sh",
    "claude-hooks/enforce-gwm-for-worktree.sh",
    "claude-hooks/fix_gfm_tables.py",
    "claude-hooks/lib",
    "claude-hooks/post-edit-checks.sh",
    "claude-hooks/rtk-rewrite.sh",
    "commands.md",
    "extensions",
    "extensions/harness-fff-mode.js",
    "extensions/harness-policy.js",
    "hook-runner",
    "mcp.json",
    "model-providers.json",
    "pi-codex-conversion.json",
    "policy",
    "rules",
    "settings.json",
    "sol-pi.json",
    "subagents.json",
    "web-search.json",
    "workflows"
  ],
  "settingsFile": "settings.json",
  "settingsFormat": "json",
  "settingsKeys": [
    "defaultProvider",
    "defaultModel",
    "defaultThinkingLevel",
    "theme",
    "quietStartup",
    "collapseChangelog",
    "hideThinkingBlock",
    "treeFilterMode",
    "enableAnalytics",
    "enableInstallTelemetry",
    "enableSkillCommands",
    "packages",
    "enabledModels",
    "compaction"
  ],
  "ledger": ".harunon-slim.installed.json"
}
