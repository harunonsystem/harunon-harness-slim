#!/bin/sh
# Start OpenCode with external Claude skill discovery disabled.
set -eu

export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1

if [ -n "${OPENCODE_REAL_BIN:-}" ]; then
  exec "$OPENCODE_REAL_BIN" "$@"
fi

if command -v mise >/dev/null 2>&1; then
  managed_root=$(mise where 'npm:@opencode/cli' 2>/dev/null || true)
  managed_bin="$managed_root/node_modules/.bin/opencode"
  if [ -n "$managed_root" ] && [ -x "$managed_bin" ]; then
    exec "$managed_bin" "$@"
  fi
fi

for candidate in \
  "$HOME/.opencode/bin/opencode" \
  "/opt/homebrew/bin/opencode" \
  "/usr/local/bin/opencode"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "ERROR: real OpenCode binary not found; set OPENCODE_REAL_BIN" >&2
exit 127
