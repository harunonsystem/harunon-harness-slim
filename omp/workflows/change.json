{
  "name": "change",
  "initialState": "review",
  "states": {
    "review": {
      "review_attached": "decide",
      "review_skipped": "publish"
    },
    "decide": {
      "accepted": "publish",
      "findings_fixed": "publish",
      "fix_selected": "review",
      "findings_deferred": "publish"
    },
    "publish": {
      "published": "complete"
    },
    "complete": {}
  },
  "actions": {
    "task.report": {
      "allowedStates": ["complete"],
      "requires": ["repository-verification-current"]
    },
    "pr.create": {
      "allowedStates": ["publish", "complete"],
      "requires": ["repository-verification-current", "pre-review-check-covers-head", "independent-review-when-required", "publication-body-current"]
    },
    "pr.update-body": {
      "allowedStates": ["publish", "complete"],
      "requires": ["repository-verification-current", "pre-review-check-covers-head", "independent-review-when-required", "publication-body-current"]
    },
    "pr.comment": {
      "allowedStates": ["publish", "complete"],
      "requires": ["repository-verification-current", "pre-review-check-covers-head", "independent-review-when-required"]
    },
    "pr.merge": {
      "allowedStates": ["publish", "complete"],
      "requires": ["repository-verification-current", "trusted-review-current-head"]
    }
  }
}
