{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harunon Harness Task State",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "phase",
    "task",
    "workflow",
    "context",
    "evidence",
    "reviewAttempts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "reviewAttempts": { "type": "integer", "minimum": 0 },
    "phase": {
      "type": "string",
      "enum": ["review", "decide", "publish", "complete"]
    },
    "task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "change" },
        "version": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["gitDir", "worktreeRoot"],
      "properties": {
        "gitDir": { "type": "string", "minLength": 1 },
        "worktreeRoot": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "trust"],
        "properties": {
          "kind": { "type": "string", "enum": ["local-review", "review-skipped", "verification", "publication-body"] },
          "publication": {
            "type": "object",
            "required": [
              "bodyReference",
              "target",
              "artifactReference",
              "references",
              "taskId",
              "repository",
              "branch"
            ],
            "properties": {
              "bodyReference": {
                "type": "object"
              },
              "artifactReference": {
                "type": "object"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "target": {
                "type": "object"
              },
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "passed": { "type": "boolean" },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "trust": { "const": "audit-only" },
          "provider": { "type": "string", "minLength": 1 },
          "subjectSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "artifact": { "type": "string", "minLength": 1 },
          "rereviewReason": { "type": "string", "minLength": 1 },
          "skipReason": { "type": "string", "enum": ["quota"] },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rereviewApproval": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
