{
  "_comment": "build-public-slim.py が packages/targets/omp/config.json から生成。install.sh はこれを読んで rsync する管理パスと設定ファイルの同期キーを決める（配列を install.sh に直書きしない）",
  "target": "omp",
  "displayName": "oh-my-pi (omp)",
  "configDir": "~/.omp/agent",
  "configDirEnv": null,
  "managedPaths": [
    "AGENTS.md",
    "claude-hooks/approve-pr.sh",
    "claude-hooks/approve-push.sh",
    "claude-hooks/block-dangerous-in-bash.sh",
    "claude-hooks/block-edit-on-main.sh",
    "claude-hooks/block-grep-in-bash.sh",
    "claude-hooks/block-japanese-tech-writing.sh",
    "claude-hooks/block-secrets-in-commit.sh",
    "claude-hooks/fix_gfm_tables.py",
    "claude-hooks/harness-publication-gate.sh",
    "claude-hooks/lib",
    "claude-hooks/post-edit-checks.sh",
    "claude-hooks/require-evidence-for-completion.py",
    "claude-hooks/rtk-rewrite.sh",
    "config.yml",
    "extensions/harness-completion-gate.js",
    "extensions/harness-policy.js",
    "extensions/omp-denial-reason.js",
    "extensions/post-edit-checks.js",
    "hook-runner",
    "mcp.json",
    "policy",
    "rules",
    "workflows"
  ],
  "settingsFile": "config.yml",
  "settingsFormat": "yaml",
  "settingsKeys": [
    "bash.patterns",
    "skills"
  ],
  "settingsRemoveKeys": [
    "permissions"
  ],
  "ledger": ".harunon-slim.installed.json"
}
